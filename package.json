{
  "name": "boxshelf",
  "productName": "EmuScape",
  "version": "2.0.25",
  "description": "TV-style launcher for emulators, Steam and media apps",
  "license": "GPL-3.0-only",
  "main": "boot.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "windowed": "electron . --windowed",
    "dist": "electron-builder --win dir && makensis -DVERSION=%npm_package_version% build/windows/emuscape.nsi",
    "dist:linux": "electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.boxshelf",
    "productName": "EmuScape",
    "files": [
      "boot.js",
      "main.js",
      "preload.js",
      "preload-home.js",
      "preload-wum.js",
      "main/**",
      "shared/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/windows/icon.ico",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "icon": "renderer/app-icon.png",
      "category": "Game",
      "synopsis": "TV-style launcher for emulators and Steam",
      "artifactName": "EmuScape-${version}-linux.${ext}"
    },
    "artifactBuildStarted": "scripts/linux-wrapper.js",
    "asar": true,
    "asarUnpack": [
      "main/lbindex.js",
      "main/pcgames.js",
      "main/pcworker.js"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "afterPack": "build/windows/afterPack.js"
  }
}
